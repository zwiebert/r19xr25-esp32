{
    "version": "2.0.0",
    "tasks": [
        {
            
            "type": "cmake",
            "label": "CMake: Build",
            "command": "build",
            "preset": "${command:cmake.activeBuildPresetName}",
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": "absolute",
                "pattern": {
                    // This regex ignores "[build] " at the start
                    "regexp": "^\\[build\\]\\s+(.*):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
